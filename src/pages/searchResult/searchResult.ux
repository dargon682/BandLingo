    padding: 1px 4px;
  }
  
  .ai-query-section-bottom {
    padding: 15px 0 8px 0;
  }
  
  .ai-query-btn {
    width: 160px;
    height: 40px;
    border-radius: 20px;
  }
  
  .ai-query-btn-text {
    font-size: 15px;
  }
}

/* 432*514 设备适配 */
@media (min-width: 432px) and (max-width: 432px) {
  .search-result-page {
    width: 432px;
    height: 514px;
  }
  
  .header {
    height: 90px;
    padding: 0 24px;
  }
  
  .back-icon-container {
    width: 140px;
    height: 55px;
    border-radius: 28px;
  }
  
  .back-icon {
    font-size: 34px;
  }
  
  .content-container {
    padding: 0 0 24px 0;
  }
  
  .search-info {
    padding: 10px 24px 20px 24px;
  }
  
  .search-mode-label {
    font-size: 24px;
  }
  
  .result-limit-inline {
    padding: 6px 12px;
    border-radius: 6px;
  }
  
  .limit-inline-text {
    font-size: 20px;
  }
  
  .search-word-text {
    font-size: 24px;
    margin-left: 8px;
  }
  
  .result-list {
    padding: 0 24px;
    overflow: scroll;
    scrollable: true;
  }
  
  .result-item-wrapper {
    margin-bottom: 14px;
  }
  
  .result-item-card {
    padding: 24px 22px;
