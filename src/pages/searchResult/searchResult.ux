  }
  
  .result-item-gradient {
    border-radius: 14px;
  }
  
  .gradient-content-overlay {
    padding: 24px 22px;
  }
  
  .result-item-list {
    padding: 22px 26px;
    border-radius: 14px;
  }
  
  .item-word-card {
    font-size: 20px;
    margin-bottom: 8px;
  }
  
  .item-definition-card {
    font-size: 16px;
    line-height: 22px;
  }
  
  .item-word-list {
    font-size: 20px;
    margin-bottom: 10px;
  }
  
  .item-definition-list {
    font-size: 18px;
    line-height: 24px;
  }
  
  .favorite-icon {
    font-size: 24px;
  }
  
  .no-result-text {
    font-size: 32px;
    margin-bottom: 40px;
  }
  
  .retry-btn {
    width: 260px;
    height: 80px;
    border-radius: 40px;
  }
  
  .retry-btn-text {
    font-size: 30px;
  }
  
  .loading-text {
    font-size: 28px;
