    this.isLoadingAI = true;
    this.aiError = null;
    console.log('开始AI查询:', searchKey);
    var self = this;
    // 直接调用AI服务（aiService 内部惰性探测 @system.fetch，不支持时返回友好错误，不崩溃）
    aiService.queryAI(searchKey, isChinese).then(function (aiResult) {
      // 将AI结果添加到结果列表的开头
      var aiItem = {
        word: searchKey,
        definition: aiResult,
        isAI: true
      };
