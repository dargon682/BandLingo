<script>
// 导入全局工具
import './common/global'
import storage from './storage'

// 词库不再以 JS 常量挂载到 global：
// 一级（tier1）、二级（full）、元数据（meta）均已拆分为按首字母的资源文件（src/common/dict/），
// 由 dictionaryIndex.preloadBucket 在检索时按需异步读取 + LRU 缓存，
// 启动不解析任何大词库对象，避免低内存设备启动 OOM 崩溃/反复重启。
// 注意：本文件不 import dictionaryIndex（避免其依赖的系统模块进入启动链路），
// 仅以固定常量展示词库统计，词库模块只在 searchResult/detail 页面加载。

export default {
  onCreate() {
    console.log("app created")
    // 初始化全局数据
    this.globalData = {
      word: '',
      definition: '',
      // 词库统计：固定常量（165563 条），避免启动加载词库模块
      dictionaryCount: 165563
    }
    // 初始化存储功能
    this.$def = {
      getStorage: function(key) {
        try {
          return storage.getSync({
            key: key,
            default: ''
          })
        } catch (e) {
          console.error('读取存储失败:', e)
          return ''
        }
      },
      setStorage: function(key, value) {
        try {
          storage.setSync({
            key: key,
            value: value
          })
          return true
        } catch (e) {
          console.error('写入存储失败:', e)
          return false
        }
      }
    }
  },
  onDestroy() {
    console.log("app destroyed")
    // 清理所有定时器
    if (typeof global !== 'undefined' && global.timerManager) {
      global.timerManager.clearAllTimers()
    }
    // 调用垃圾回收
    if (typeof global !== 'undefined' && global.runGC) {
      global.runGC()
    }
  }
}
</script>
