            aiDictionary = {};
          }
        }

        // 添加新单词
        aiDictionary[wordKey] = definition;

        // 保存回存储
        storage.set({
          key: 'ai_dictionary',
          value: JSON.stringify(aiDictionary),
          success: function success() {
            console.log('AI词典已保存:', wordKey);
          },
          fail: function fail(err) {
            console.error('保存AI词典失败:', err);
          }
        });
      },
      fail: function fail(err) {
        console.error('读取AI词典失败:', err);
        // 即使读取失败，也创建新的词典
        var aiDictionary = {};
        aiDictionary[wordKey] = definition;
        storage.set({
          key: 'ai_dictionary',
          value: JSON.stringify(aiDictionary),
          success: function success() {
            console.log('AI词典已创建并保存:', wordKey);
          },
          fail: function fail(err) {
            console.error('创建AI词典失败:', err);
          }
        });
      }
    });
  },
  // 从AI词典中搜索（异步）：并入主列表后重新筛选/分页
  searchFromAIDictionary: function searchFromAIDictionary(searchKey, isChinese) {
    var _this3 = this;
    storage.get({
      key: 'ai_dictionary',
      default: '',
      success: function success(savedData) {
        if (!savedData) return;
        try {
          var aiDictionary = JSON.parse(savedData);
          var searchKeyLower = searchKey.toLowerCase().trim();
          var ext = [];
          if (isChinese) {
            for (var word in aiDictionary) {
              var definition = aiDictionary[word];
              if (definition && definition.includes(searchKey)) {
                ext.push({
                  word: word,
                  definition: definition,
                  isAI: true
                });
              }
            }
          } else {
            if (aiDictionary[searchKeyLower]) {
              ext.push({
                word: searchKeyLower,
                definition: aiDictionary[searchKeyLower],
                isAI: true
              });
            }
            for (var _word in aiDictionary) {
              if (_word.toLowerCase() !== searchKeyLower && _word.toLowerCase().includes(searchKeyLower)) {
                ext.push({
                  word: _word,
                  definition: aiDictionary[_word],
                  isAI: true
                });
              }
            }
          }
          _this3.mergeExternal(ext);
          console.log('从AI词典搜索完成');
        } catch (e) {
          console.error('解析AI词典失败:', e);
        }
      },
      fail: function fail(err) {
        console.log('AI词典不存在或读取失败');
      }
    });
  },
  // 从手动词库中搜索（异步）：并入主列表后重新筛选/分页
  searchFromManualDictionary: function searchFromManualDictionary(searchKey, isChinese) {
    var _this4 = this;
    storage.get({
      key: 'manual_dictionary',
      default: '',
      success: function success(savedData) {
        if (!savedData) return;
        try {
          var manualDictionary = JSON.parse(savedData);
          var searchKeyLower = searchKey.toLowerCase().trim();
          var ext = [];
          if (isChinese) {
            for (var word in manualDictionary) {
              var definition = manualDictionary[word];
              if (definition && definition.includes(searchKey)) {
                ext.push({
                  word: word,
                  definition: definition,
                  isManual: true
                });
              }
            }
          } else {
            if (manualDictionary[searchKeyLower]) {
              ext.push({
                word: searchKeyLower,
                definition: manualDictionary[searchKeyLower],
                isManual: true
              });
            }
            for (var _word2 in manualDictionary) {
              if (_word2.toLowerCase() !== searchKeyLower && _word2.toLowerCase().includes(searchKeyLower)) {
                ext.push({
                  word: _word2,
                  definition: manualDictionary[_word2],
                  isManual: true
                });
              }
            }
          }
          _this4.mergeExternal(ext);
          console.log('从手动词库搜索完成');
        } catch (e) {
          console.error('解析手动词库失败:', e);
        }
      },
      fail: function fail(err) {
        console.log('手动词库不存在或读取失败');
      }
    });
  },
  // 将外部词源（AI/手动）去重并入主列表，并重新筛选+分页
  mergeExternal: function mergeExternal(ext) {
    var _this5 = this;
    if (!ext || ext.length === 0) return;
    var added = [];
    var _loop = function _loop() {
      var it = ext[i];
      var exists = _this5.masterResults.some(function (m) {
        return m.word.toLowerCase() === it.word.toLowerCase();
      });
      if (!exists) added.push(it);
    };
    for (var i = 0; i < ext.length; i++) {
      _loop();
    }
    if (added.length === 0) return;
    // 新词源置前（unshift）
    this.masterResults = added.concat(this.masterResults);
    this.applyFilters();
  },
  checkAIFavoriteStatus: function checkAIFavoriteStatus(aiItem) {
    try {
      // 说明：不使用 Set（低内存/精简设备 JS 引擎可能不支持），改用数组 includes
      var favWords = readFavorites().map(function (item) {
        return item.word;
      });
      aiItem.isFavorited = favWords.indexOf(aiItem.word) > -1;
    } catch (e) {
      console.error('检查AI结果收藏状态失败:', e);
    }
  },
  showDonationTip: function showDonationTip() {
    // 显示价格和捐赠提示
    console.log('显示捐赠提示');
  },
  checkFavoritesStatus: function checkFavoritesStatus() {
    try {
      var favorites = readFavorites();
      // 说明：不使用 Set（低内存/精简设备 JS 引擎可能不支持），改用数组 indexOf
      var favWords = favorites.map(function (item) {
        return item.word;
      });
      this.results.forEach(function (item) {
        item.isFavorited = favWords.indexOf(item.word) > -1;
      });
    } catch (e) {
      console.error('检查收藏状态失败:', e);
    }
  },
  toggleFavorite: function toggleFavorite(item, event) {
    // 阻止事件冒泡，防止触发跳转
    if (event && event.stopPropagation) {
      event.stopPropagation();
    }

    // 验证item参数
    if (!item || !item.word) {
      console.error('收藏失败：无效的item参数', item);
      return;
    }
    console.log('=== 收藏按钮被点击 ===');
    console.log('单词:', item.word);
    console.log('当前状态:', item.isFavorited);

    // 获取当前收藏列表（复用统一的安全读取逻辑）
    var favorites = readFavorites();
    console.log('获取收藏列表成功，数量:', favorites.length);

    // 查找当前单词在收藏列表中的索引
    var existingIndex = favorites.findIndex(function (fav) {
      return fav.word === item.word;
    });
    console.log('单词在收藏列表中的位置:', existingIndex);
    if (existingIndex >= 0) {
      // 取消收藏
      favorites.splice(existingIndex, 1);
      item.isFavorited = false;
      console.log('取消收藏成功');
    } else {
      // 添加收藏
      favorites.push({
        word: item.word,
        definition: item.definition || '',
        addedTime: new Date().getTime()
      });
      item.isFavorited = true;
      console.log('添加收藏成功');
    }

    // 保存收藏列表（统一异常处理）
    if (!saveFavorites(favorites)) {
      console.error('保存收藏失败');
      item.isFavorited = existingIndex >= 0; // 恢复原始状态
    } else {
      console.log('保存收藏列表成功');
    }
  },
  goBack: function goBack() {
    var routerMod = getRouterModule();
    if (routerMod && typeof routerMod.back === 'function') {
      routerMod.back();
    }
  },
  goToDetail: function goToDetail(item) {
    console.log('=== 开始跳转到详情页 ===');
    console.log('单词:', item.word);
    console.log('释义:', item.definition);
    console.log('完整item对象:', JSON.stringify(item));

    // 确保参数存在
    if (!item || !item.word) {
      console.error('跳转失败：缺少必要参数');
      return;
    }

    // 确保全局变量对象存在
    if (!this.$app.globalData) {
      this.$app.globalData = {};
    }

    // 设置全局变量
    this.$app.globalData.word = item.word;
    this.$app.globalData.definition = item.definition || '';
    console.log('已设置全局变量:', this.$app.globalData);

    // 方法2：尝试标准跳转
    try {
      var routerMod = getRouterModule();
      if (!routerMod || typeof routerMod.push !== 'function') {
        console.error('路由模块不可用');
        return;
      }
      routerMod.push({
        uri: '/pages/detail',
        params: {
          word: item.word,
          definition: item.definition || ''
        }
      });
      console.log('标准跳转调用成功');
    } catch (error) {
      console.error('标准跳转失败:', error);

      // 方法3：简化跳转
      try {
        var routerMod2 = getRouterModule();
        if (routerMod2 && typeof routerMod2.push === 'function') {
          routerMod2.push({
            uri: '/pages/detail'
          });
          console.log('简化跳转调用成功');
        }
      } catch (simpleError) {
        console.error('简化跳转也失败:', simpleError);
      }
    }
    console.log('=== 跳转方法调用完成 ===');
  },
  closeDonationTip: function closeDonationTip() {
    this.showDonation = false;
  },
  onDestroy: function onDestroy() {
    // 页面销毁时清理数据，避免内存泄漏
    this.results.length = 0;
    this.word = "";
    // 释放二级桶缓存（LRU 桶对象），降低常驻内存
    clearCache();
    // 调用垃圾回收
    if (typeof global !== 'undefined' && global.runGC) {
      global.runGC();
    }
  }
};</script>

<style>
.search-result-page {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
}

.header {
  width: 100%;
  height: 80px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 0 24px;
}

.back-icon-container {
  width: 120px;
  height: 50px;
  justify-content: center;
  align-items: center;
  background-color: #1C1C1E;
  border-radius: 25px;
  border: 2px solid #2C2C2E;
}

.back-icon {
  font-size: 30px;
  color: #FFFFFF;
}

.page-title {
  font-size: 28px;
  color: #FFFFFF;
  font-weight: bold;
  margin-left: 16px;
}

.content-container {
  flex: 1;
  flex-direction: column;
  width: 100%;
  padding: 0 0 20px 0;
}

.search-info {
  padding: 8px 20px 16px 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.search-word-container {
  flex-direction: row;
  align-items: center;
}

.search-mode-label {
  font-size: 20px;
  font-weight: bold;
  color: #007AFF;
}

.result-limit-inline {
  background-color: #2C2C2E;
  padding: 4px 10px;
  border-radius: 5px;
  align-items: center;
}

.limit-inline-text {
  font-size: 18px;
  color: #FF9500;
  font-weight: 500;
}

.search-word-text {
  font-size: 20px;
  color: #0A84FF;
  margin-left: 6px;
  font-weight: bold;
}

.filter-bar {
  width: 100%;
  padding: 4px 20px 6px 20px;
  flex-direction: row;
  align-items: center;
}

.filter-chip {
  flex: 1;
  margin-right: 10px;
  padding: 6px 4px;
  border-radius: 16px;
  background-color: #1C1C1E;
  border: 2px solid #3A3A3C;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.filter-chip.chip-active {
  border-color: #0A84FF;
  background-color: rgba(10, 132, 255, 0.16);
}

.filter-reset.chip-active {
  border-color: #FF9F0A;
  background-color: rgba(255, 159, 10, 0.14);
}

.filter-reset {
  flex: none;
  width: 92px;
  margin-right: 0; /* 替代不支持的 :last-child 伪类 */
}

.filter-chip-label {
  font-size: 15px;
  color: #8E8E93;
  margin-right: 6px;
}

.filter-chip-value {
  font-size: 15px;
  color: #0A84FF;
  font-weight: bold;
}

.item-meta {
  align-self: flex-start;
  font-size: 12px;
  color: #32D74B;
  margin-top: 6px;
  padding: 3px 10px;
  border-radius: 10px;
  background-color: rgba(50, 215, 75, 0.14);
  lines: 1;
  text-overflow: ellipsis;
  max-lines: 1;
}

.load-more {
  width: 100%;
  padding: 14px 0;
  justify-content: center;
  align-items: center;
}

.load-more-text {
  font-size: 16px;
  color: #0A84FF;
}

.result-list {
  flex: 1;
  width: 100%;
  padding: 0 20px;
  flex-direction: column;
  overflow: scroll;
  scrollable: true;
}

/* 列表项容器 */
.result-item-wrapper {
  width: 100%;
  margin-bottom: 14px;
}

/* 卡片样式 (彩色小卡片) */
.result-item-card {
  width: 100%;
  padding: 22px 20px;
  border-radius: 14px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

/* 渐变卡片样式 */
.result-item-gradient {
  width: 100%;
  border-radius: 14px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.15);
  position: relative;
  overflow: hidden;
}

.gradient-bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.gradient-content-overlay {
  width: 100%;
  padding: 22px 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

/* 列表样式 (经典样式) */
.result-item-list {
  width: 100%;
  padding: 20px 24px;
  border-radius: 12px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  background-color: #2D2D2D;
}

.item-content {

  flex-direction: column;

  flex: 1;

  margin-right: 10px;

}



/* 通用文字样式 */

.item-word {

  font-size: 20px;

  color: #FFFFFF;

  font-weight: bold;

  margin-bottom: 10px;

  lines: 1;

  text-overflow: ellipsis;

}



.item-definition {

  font-size: 15px;

  color: #F0F0F0;

  lines: 2;

  text-overflow: ellipsis;

  line-height: 22px;

}



/* 经典样式文字颜色调整 */

.result-item-list .item-word {

  color: #007AFF;

}



.result-item-list .item-definition {

  color: #DDDDDD;

}

.item-actions {
  flex-direction: row;
  align-items: center;
  padding: 10px;
  margin: -10px;
}

.arrow-icon {
  font-size: 20px;
  color: #3A3A3C;
  margin-right: 10px;
}

.favorite-btn {
  justify-content: center;
  align-items: center;
  min-width: 40px;
  min-height: 40px;
}

.favorite-icon {
  font-size: 22px;
  color: #FFD700;
}

.no-result {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.no-result-text {
  font-size: 28px;
  color: #8E8E93;
  margin-bottom: 35px;
}

.retry-btn {
  width: 230px;
  height: 70px;
  border-radius: 35px;
  background-color: #1C1C1E;
  justify-content: center;
  align-items: center;
  border: 1px solid #3A3A3C;
}

.retry-btn-text {
  color: #FFFFFF;
  font-size: 26px;
}

.donation-tip {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8px 16px;
  background-color: rgba(255, 215, 0, 0.9);
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.donation-text {
  font-size: 14px;
  color: #000000;
  text-align: center;
  font-weight: 500;
}

.ai-loading {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.loading-text {
  font-size: 24px;
  color: #007AFF;
  margin-bottom: 20px;
}

.ai-error {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.error-text {
  font-size: 20px;
  color: #FF3B30;
  margin-bottom: 20px;
  text-align: center;
  padding: 0 20px;
}

.ai-result {
  border: 2px solid #007AFF;
}

.ai-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  background-color: #007AFF;
  color: #FFFFFF;
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 4px;
  font-weight: bold;
}

.ai-query-section-bottom {
  width: 100%;
  padding: 20px 0 10px 0;
  justify-content: center;
  align-items: center;
}

.ai-query-btn {
  width: 200px;
  height: 50px;
  border-radius: 25px;
  background-color: #007AFF;
  justify-content: center;
  align-items: center;
}

.ai-query-btn-text {
  color: #FFFFFF;
  font-size: 18px;
  font-weight: bold;
}

/* 小米手环9 Pro 336*480 适配 */
@media (min-width: 336px) and (max-width: 336px) {
