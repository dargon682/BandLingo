<template>
  <div class="search-result-page">
    <div class="header">
      <div class="back-icon-container" onclick="goBack">
        <text static class="back-icon">←</text>
      </div>
    </div>

    <div class="content-container">
      <div class="search-info" if="{{ word }}">
        <div class="search-word-container">
          <text static class="search-mode-label">{{ searchMode }}: </text>
          <text class="search-word-text">"{{ word }}"</text>
        </div>
        <div class="result-limit-inline" if="{{ showLimitNotice }}">
          <text static class="limit-inline-text">结果过多(前{{ maxResults }}个)</text>
        </div>
      </div>

      <!-- 分类筛选栏（任务1：词性/考段 可检索筛选） -->
      <div class="filter-bar" if="{{ showFilterBar }}">
        <div class="filter-chip {{ posFilter ? 'chip-active' : '' }}" onclick="cyclePos">
          <text static class="filter-chip-label">词性</text>
          <text class="filter-chip-value">{{ posLabel }}</text>
        </div>
        <div class="filter-chip {{ levelFilter ? 'chip-active' : '' }}" onclick="cycleLevel">
          <text static class="filter-chip-label">考段</text>
          <text class="filter-chip-value">{{ levelLabel }}</text>
        </div>
        <div class="filter-chip filter-reset {{ (posFilter || levelFilter) ? 'chip-active' : '' }}" onclick="resetFilters">
          <text static class="filter-chip-label">重置</text>
        </div>
      </div>

      <div class="result-list" if="{{ results.length > 0 && !isLoadingAI }}">
        <div class="result-item-wrapper" for="{{($idx, $item) in results}}">
          <!-- 经典样式 -->
          <div class="result-item result-item-list {{ $item.isAI ? 'ai-result' : '' }}" if="{{ uiStyle === 'classic' }}" onclick="goToDetail($item)">
            <div class="item-content">
              <text class="item-word">{{ $item.word }}</text>
              <text class="item-definition">{{ $item.definition }}</text>
              <text class="item-meta" if="{{ $item.pos || $item.level }}">{{ metaText($item) }}</text>
              <text class="ai-badge" if="{{ $item.isAI }}">AI</text>
            </div>
            <div class="item-actions" onclick="toggleFavorite($item, $event)">
              <text class="favorite-icon">{{ $item.isFavorited ? '⭐' : '☆' }}</text>
            </div>
          </div>
          
          <!-- 彩色卡片样式 -->
          <div class="result-item result-item-card {{ $item.isAI ? 'ai-result' : '' }}" if="{{ uiStyle === 'colorful' }}" style="background-color: {{ getCardColor($idx) }}" onclick="goToDetail($item)">
            <div class="item-content">
              <text class="item-word">{{ $item.word }}</text>
              <text class="item-definition">{{ $item.definition }}</text>
              <text class="item-meta" if="{{ $item.pos || $item.level }}">{{ metaText($item) }}</text>
              <text class="ai-badge" if="{{ $item.isAI }}">AI</text>
            </div>
            <div class="item-actions" onclick="toggleFavorite($item, $event)">
              <text class="favorite-icon">{{ $item.isFavorited ? '⭐' : '☆' }}</text>
            </div>
          </div>
          
          <!-- 渐变卡片样式 -->
          <div class="result-item result-item-gradient {{ $item.isAI ? 'ai-result' : '' }}" if="{{ uiStyle === 'gradient' }}" onclick="goToDetail($item)">
            <image class="gradient-bg-image" src="{{ getGradientImage($idx) }}"></image>
            <div class="gradient-content-overlay">
              <div class="item-content">
                <text class="item-word">{{ $item.word }}</text>
                <text class="item-definition">{{ $item.definition }}</text>
                <text class="ai-badge" if="{{ $item.isAI }}">AI</text>
              </div>
              <div class="item-actions" onclick="toggleFavorite($item, $event)">
                <text class="favorite-icon">{{ $item.isFavorited ? '⭐' : '☆' }}</text>
              </div>
            </div>
          </div>
        </div>
        
        <!-- 惰性分页：查看更多 -->
        <div class="load-more" if="{{ filteredTotal > results.length }}" onclick="loadMore">
          <text static class="load-more-text">查看更多 ({{ results.length }}/{{ filteredTotal }})</text>
        </div>

        <!-- 问AI按钮放在列表底部 -->
        <div class="ai-query-section-bottom" if="{{ !aiError }}">
          <div class="ai-query-btn" onclick="performAIQuery">
            <text static class="ai-query-btn-text">不满意？问AI</text>
          </div>
        </div>
      </div>

      <div class="ai-loading" if="{{ isLoadingAI }}">
        <text static class="loading-text">AI正在查询中...</text>
      </div>

      <div class="ai-error" if="{{ aiError && !isLoadingAI && results.length === 0 }}">
        <text static class="error-text">{{ aiError }}</text>
        <div class="retry-btn" onclick="performAIQuery">
          <text static class="retry-btn-text">重试</text>
        </div>
      </div>

      <div class="no-result" if="{{ results.length === 0 && !isLoadingAI && !aiError }}">
        <text static class="no-result-text">未找到相关单词</text>
        <div class="ai-query-btn" onclick="performAIQuery">
          <text static class="ai-query-btn-text">试试AI</text>
        </div>
        <div class="retry-btn" onclick="goBack">
          <text static class="retry-btn-text">返回重新搜索</text>
        </div>
      </div>
    </div>
    
    <!-- 捐赠提示 - 固定在底部 -->
    <div class="donation-tip" if="{{ showDonation }}">
      <text class="donation-text">AI功能价格昂贵，请各位帅哥美女捐赠一点吧~</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "../../storage"
import { getKeys, getSortedKeys, exactLookup, ensureFullBucket, clearCache, searchByPrefix, getPosLevel, suggestFuzzy, cacheGet, cachePut, preloadBucket, getDefinition } from "../../common/dictionaryIndex"
import { CARD_COLORS, GRADIENT_IMAGES } from "../../common/uiTheme"
import { POS_OPTIONS, POS_LABELS, LEVEL_OPTIONS, LEVEL_LABELS } from "../../common/filterOptions"
import { readFavorites, saveFavorites } from "../../common/favorites"

// 词库全部按需异步加载（见 dictionaryIndex.js），释义经 getDefinition 从已加载桶读取。

export default {
  data: {
    word: "",
    results: [],
    masterResults: [],        // 原始检索结果（未筛选未分页）
    filtered: [],             // 筛选后结果（惰性分页数据源）
    filteredTotal: 0,
    posFilter: '',            // 词性筛选游标值（''=全部）
    levelFilter: '',          // 考段筛选游标值（''=全部）
    posLabel: '全部',
    levelLabel: '全部',
    visibleLimit: 20,         // 惰性分页：单页条数
    posOptions: POS_OPTIONS,
    levelOptions: LEVEL_OPTIONS,
    posLabels: POS_LABELS,
    levelLabels: LEVEL_LABELS,
    showFilterBar: false,
    showLimitNotice: false,
    maxResults: 0,
    searchMode: "搜索",
    isLoadingAI: false,
    aiError: null,
    showDonationAlert: false,
    uiStyle: 'classic',
    cardColors: CARD_COLORS,
    gradientImages: GRADIENT_IMAGES
  },

  onInit() {
    console.log('=== 搜索结果页面初始化 ===');
    console.log('完整的params对象:', this.params);
    console.log('params.word:', this.params ? this.params.word : 'undefined');
    
    // 重置分类筛选游标
    this.posFilter = '';
    this.levelFilter = '';
    this.posLabel = '全部';
    this.levelLabel = '全部';
    this.filteredTotal = 0;
    
    // 加载UI样式设置
    this.loadUIStyle();
    
    // 从路由参数中获取搜索词
    if (this.params && this.params.word) {
      this.word = this.params.word;
      console.log('搜索结果页面 - 接收到搜索词:', this.word);
    } else {
      console.log('搜索结果页面 - 未接收到搜索词参数');
    }
    
    console.log('即将执行搜索，当前word:', this.word);
    // 预载目标首字母的二级桶/元数据（资源文件按需读取），加载完成后再搜索，
    // 确保一级高频词 + 二级生僻词结果完整；词未变时才刷新，避免重复搜索
    const c0 = (this.word || "").charAt(0).toLowerCase();
    if (/^[a-z]$/.test(c0)) {
      preloadBucket(c0, () => {
        if (this.word && this.word.charAt(0).toLowerCase() === c0) {
          this.performSearch();
        }
      });
    } else {
      this.performSearch();
    }
  },

  onShow() {
    this.loadUIStyle();
  },

  loadUIStyle() {
    storage.get({
      key: 'ui_style',
      default: 'classic',
      success: (data) => {
        this.uiStyle = data || 'classic';
        console.log('加载UI样式:', this.uiStyle);
      },
      fail: () => {
        this.uiStyle = 'classic';
      }
    });
  },

  getCardColor(idx) {
    return this.cardColors[idx % this.cardColors.length];
  },

  getGradientImage(idx) {
    return this.gradientImages[idx % this.gradientImages.length];
  },

  metaText(item) {
    const p = (item && item.pos && this.posLabels[item.pos]) || '';
    const l = (item && item.level && this.levelLabels[item.level]) || '';
    if (p && l) return p + ' · ' + l;
    return p || l || '';
  },

  performSearch() {
    const searchKey = (this.word || "").trim();
    const matches = [];
    
    // 判断是否为中文输入
    const isChinese = /[\u4e00-\u9fa5]/.test(searchKey);
    
    // 设置搜索模式标签
    this.searchMode = isChinese ? "中→英" : "英→中";
    
    // 重置AI相关状态
    this.isLoadingAI = false;
    this.aiError = null;
    
    const dictionaryKeys = getKeys();
    
    if (searchKey) {
      // 检索结果 LRU 缓存（重复查询秒回）
      const cacheKey = (isChinese ? "c:" : "e:") + searchKey.toLowerCase();
      const cached = cacheGet(cacheKey);
      if (cached) {
        this.masterResults.length = 0;
        for (let i = 0; i < cached.length; i++) this.masterResults.push(cached[i]);
      } else {
        if (isChinese) {
          this.searchChineseToEnglish(searchKey, matches, dictionaryKeys);
        } else {
          this.searchEnglishToChinese(searchKey, matches, dictionaryKeys);
          // 无命中时触发错拼纠错建议
          if (matches.length === 0) {
            const sug = suggestFuzzy(searchKey);
            if (sug) {
              const hit = exactLookup(sug);
              if (hit) matches.push(Object.assign({ isSuggest: true }, hit));
            }
          }
        }
        this.masterResults.length = 0;
        for (let i = 0; i < matches.length; i++) this.masterResults.push(matches[i]);
        cachePut(cacheKey, this.masterResults.slice());
      }
      
      // 同时搜索AI词典
      this.searchFromAIDictionary(searchKey, isChinese);
      
      // 同时搜索手动词库
      this.searchFromManualDictionary(searchKey, isChinese);
    } else {
      this.showLimitNotice = false;
      this.maxResults = 0;
      this.masterResults.length = 0;
    }
    
    // 应用筛选 + 懒加载分页（A2 筛选作用于结果集）
    this.applyFilters();
    
    console.log('搜索完成，找到', this.results.length, '个结果（主列表', this.masterResults.length, '）');
  },

  // A2：筛选作用于检索结果集（不扫描全库）
  matchesFilter(it) {
    const pos = this.posFilter;
    const level = this.levelFilter;
    if (pos && it.pos !== pos) return false;
    if (level) {
      if (level === 'basic') {
        if (it.level && it.level !== 'basic') return false;
      } else if (it.level !== level) {
        return false;
      }
    }
    return true;
  },

  applyFilters() {
    const filtered = [];
    for (let i = 0; i < this.masterResults.length; i++) {
      if (this.matchesFilter(this.masterResults[i])) filtered.push(this.masterResults[i]);
    }
    this.filtered = filtered;               // 保留筛选结果供惰性分页追加
    this.filteredTotal = filtered.length;
    this.showFilterBar = filtered.length > 0;
    // 惰性分页：仅渲染前 visibleLimit 条（A_extra：列表超限分页展示）
    const end = Math.min(this.visibleLimit, filtered.length);
    this.results.length = 0;
    for (let i = 0; i < end; i++) this.results.push(filtered[i]);
    // 检查每个结果的收藏状态
    this.checkFavoritesStatus();
  },

  // 惰性分页：加载更多（从已筛选中追加下一页）
  loadMore() {
    const end = Math.min(this.filteredTotal, this.results.length + this.visibleLimit);
    for (let i = this.results.length; i < end; i++) {
      this.results.push(this.filtered[i]);
    }
    return this.results.length >= this.filteredTotal;
  },

  // 词性筛选：循环切换
  cyclePos() {
    const cur = this.posOptions.indexOf(this.posFilter);
    const next = (cur + 1) % this.posOptions.length;
    this.posFilter = this.posOptions[next];
    this.posLabel = this.posLabels[this.posFilter];
    this.applyFilters();
  },

  // 考段筛选：循环切换
  cycleLevel() {
    const cur = this.levelOptions.indexOf(this.levelFilter);
    const next = (cur + 1) % this.levelOptions.length;
    this.levelFilter = this.levelOptions[next];
    this.levelLabel = this.levelLabels[this.levelFilter];
    this.applyFilters();
  },

  resetFilters() {
    this.posFilter = '';
    this.levelFilter = '';
    this.posLabel = '全部';
    this.levelLabel = '全部';
    this.applyFilters();
  },

  // 英文翻译中文的搜索逻辑（A1 前缀二分定位 + A4 Top-K + 长度剪枝 + 元数据）
  searchEnglishToChinese(searchKey, matches, dictionaryKeys) {
    const searchKeyLower = searchKey.toLowerCase().replace(/[^a-z]/g, '');
    if (!searchKeyLower) {
      this.showLimitNotice = false;
      this.maxResults = 0;
      return;
    }

    // 1. 精确匹配（一级 O(1)；未命中自动按需解析二级对应首字母桶）
    let exact = exactLookup(searchKeyLower);
    if (exact) matches.push(Object.assign({}, exact));

    // 2. 模糊匹配
    const isSingleChar = searchKeyLower.length === 1;
    const maxResults = isSingleChar ? 75 : 60;
    const startsWithMatches = [];
    const containsMatches = [];
    const c0 = searchKeyLower.charAt(0);

    if (isSingleChar) {
      // 单字：一级 keys 中该字母开头的短词（<=8字符）+ 包含该字母的短词
      let c = 0;
      for (let i = 0; i < dictionaryKeys.length && c < maxResults; i++) {
        const key = dictionaryKeys[i];
        if (key.length > 8 || key === searchKeyLower) continue;
        if (key.charAt(0) === c0) {
          const meta = getPosLevel(key);
          startsWithMatches.push({ word: key, definition: getDefinition(key), pos: meta.pos, level: meta.level });
          c++;
        }
      }
      // 补充：一级中含该字母的短词（不限于开头）
      const needContain = maxResults - startsWithMatches.length;
      if (needContain > 0) {
        let cc = 0;
        for (let i = 0; i < dictionaryKeys.length && cc < needContain; i++) {
          const key = dictionaryKeys[i];
          if (key.length > 8 || key === searchKeyLower || key.charAt(0) === c0) continue;
          if (key.includes(searchKeyLower)) {
            const meta = getPosLevel(key);
            containsMatches.push({ word: key, definition: getDefinition(key), pos: meta.pos, level: meta.level });
            cc++;
          }
        }
      }
      // 补充：二级对应首字母桶中的生僻短词
      const bucket = ensureFullBucket(c0);
      if (bucket) {
        for (const key in bucket) {
          if (startsWithMatches.length + containsMatches.length >= maxResults) break;
          if (key.length > 8 || key === searchKeyLower || getDefinition(key)) continue;
          startsWithMatches.push({ word: key, definition: bucket[key].def, pos: bucket[key].pos || '', level: bucket[key].level || '' });
        }
      }
    } else {
      // 多字：A1 前缀二分下界定位起点 + 长度剪枝 + Top-K（含二级生僻桶兜底）
      const p = searchKeyLower;
      const pfx = searchByPrefix(p, { max: maxResults });
      for (let i = 0; i < pfx.length && startsWithMatches.length < maxResults; i++) {
        const it = pfx[i];
        if (it.word === searchKeyLower) continue;
        startsWithMatches.push(it);
      }
    }

    matches.push.apply(matches, startsWithMatches);
    matches.push.apply(matches, containsMatches.slice(0, Math.max(0, maxResults - startsWithMatches.length)));

    // 设置限制提示状态
    this.showLimitNotice = (startsWithMatches.length + containsMatches.length) >= maxResults;
    this.maxResults = maxResults;
  },

  // 中文翻译英文的搜索逻辑（仅在一级常驻高频词中反查，避免全库解压）
  searchChineseToEnglish(searchKey, matches, dictionaryKeys) {
    const maxResults = 100; // 中文搜索限制100个结果
    const exactMatches = [];
    const partialMatches = [];
    
    // 在所有英文单词的释义中搜索中文
    for (let i = 0; i < dictionaryKeys.length; i++) {
      const englishWord = dictionaryKeys[i];
      const chineseDefinition = getDefinition(englishWord);
      const meta = getPosLevel(englishWord);
      
      // 精确匹配中文（优先级最高）
      if (chineseDefinition === searchKey) {
        exactMatches.push({
          word: englishWord,
          definition: chineseDefinition,
          pos: meta.pos,
          level: meta.level
        });
      } else if (chineseDefinition.indexOf(searchKey) > -1) {
        // 模糊匹配中文（包含搜索词）
        partialMatches.push({
          word: englishWord,
          definition: chineseDefinition,
          pos: meta.pos,
          level: meta.level
        });
      }
    }
    
    // 先添加精确匹配的结果，再添加部分匹配的结果
    matches.push(...exactMatches);
    
    // 限制部分匹配的数量
    const remainingSlots = maxResults - exactMatches.length;
    if (remainingSlots > 0) {
      matches.push(...partialMatches.slice(0, remainingSlots));
    }
    
    // 设置限制提示状态
    this.showLimitNotice = (exactMatches.length + partialMatches.length) > maxResults;
    this.maxResults = maxResults;
  },

  async performAIQuery() {
    const searchKey = (this.word || "").trim();
    if (!searchKey) {
      return;
    }
    
    const isChinese = /[\u4e00-\u9fa5]/.test(searchKey);
    
    this.isLoadingAI = true;
    this.aiError = null;
    
    try {
      console.log('开始AI查询:', searchKey);
      
      // 动态导入AI服务
      const aiService = await import("../../common/aiService");
      const aiResult = await aiService.queryAI(searchKey, isChinese);
      
      // 将AI结果添加到结果列表的开头
      const aiItem = {
        word: searchKey,
        definition: aiResult,
        isAI: true
      };
      
      this.results.unshift(aiItem);
      
      // 检查AI结果的收藏状态
      this.checkAIFavoriteStatus(aiItem);
      
      // 将AI查询结果存入本地词典
      this.saveToAIDictionary(searchKey, aiResult);
      
      // 直接显示捐赠提示
      this.showDonationAlert = true;
      
      console.log('AI查询成功，结果已添加并保存到词典');
    } catch (error) {
      console.error('AI查询失败:', error);
      this.aiError = error.message || 'AI查询服务暂时不可用';
    } finally {
      this.isLoadingAI = false;
    }
  },

  // 将AI查询结果保存到本地词典（异步）
  saveToAIDictionary(word, definition) {
    const wordKey = word.toLowerCase().trim();
    
    // 先获取现有词典
    storage.get({
      key: 'ai_dictionary',
      default: '',
      success: (savedData) => {
        let aiDictionary = {};
        
        if (savedData) {
          try {
            aiDictionary = JSON.parse(savedData);
          } catch (e) {
            console.error('解析AI词典失败:', e);
            aiDictionary = {};
          }
        }
        
        // 添加新单词
        aiDictionary[wordKey] = definition;
        
        // 保存回存储
        storage.set({
          key: 'ai_dictionary',
          value: JSON.stringify(aiDictionary),
          success: () => {
            console.log('AI词典已保存:', wordKey);
          },
          fail: (err) => {
            console.error('保存AI词典失败:', err);
          }
        });
      },
      fail: (err) => {
        console.error('读取AI词典失败:', err);
        // 即使读取失败，也创建新的词典
        const aiDictionary = {};
        aiDictionary[wordKey] = definition;
        
        storage.set({
          key: 'ai_dictionary',
          value: JSON.stringify(aiDictionary),
          success: () => {
            console.log('AI词典已创建并保存:', wordKey);
          },
          fail: (err) => {
            console.error('创建AI词典失败:', err);
          }
        });
      }
    });
  },

  // 从AI词典中搜索（异步）：并入主列表后重新筛选/分页
  searchFromAIDictionary(searchKey, isChinese) {
    storage.get({
      key: 'ai_dictionary',
      default: '',
      success: (savedData) => {
        if (!savedData) return;
        try {
          const aiDictionary = JSON.parse(savedData);
          const searchKeyLower = searchKey.toLowerCase().trim();
          const ext = [];
          if (isChinese) {
            for (const word in aiDictionary) {
              const definition = aiDictionary[word];
              if (definition && definition.includes(searchKey)) {
                ext.push({ word: word, definition: definition, isAI: true });
              }
            }
          } else {
            if (aiDictionary[searchKeyLower]) {
              ext.push({ word: searchKeyLower, definition: aiDictionary[searchKeyLower], isAI: true });
            }
            for (const word in aiDictionary) {
              if (word.toLowerCase() !== searchKeyLower && word.toLowerCase().includes(searchKeyLower)) {
                ext.push({ word: word, definition: aiDictionary[word], isAI: true });
              }
            }
          }
          this.mergeExternal(ext);
          console.log('从AI词典搜索完成');
        } catch (e) {
          console.error('解析AI词典失败:', e);
        }
      },
      fail: (err) => {
        console.log('AI词典不存在或读取失败');
      }
    });
  },

  // 从手动词库中搜索（异步）：并入主列表后重新筛选/分页
  searchFromManualDictionary(searchKey, isChinese) {
    storage.get({
      key: 'manual_dictionary',
      default: '',
      success: (savedData) => {
        if (!savedData) return;
        try {
          const manualDictionary = JSON.parse(savedData);
          const searchKeyLower = searchKey.toLowerCase().trim();
          const ext = [];
          if (isChinese) {
            for (const word in manualDictionary) {
              const definition = manualDictionary[word];
              if (definition && definition.includes(searchKey)) {
                ext.push({ word: word, definition: definition, isManual: true });
              }
            }
          } else {
            if (manualDictionary[searchKeyLower]) {
              ext.push({ word: searchKeyLower, definition: manualDictionary[searchKeyLower], isManual: true });
            }
            for (const word in manualDictionary) {
              if (word.toLowerCase() !== searchKeyLower && word.toLowerCase().includes(searchKeyLower)) {
                ext.push({ word: word, definition: manualDictionary[word], isManual: true });
              }
            }
          }
          this.mergeExternal(ext);
          console.log('从手动词库搜索完成');
        } catch (e) {
          console.error('解析手动词库失败:', e);
        }
      },
      fail: (err) => {
        console.log('手动词库不存在或读取失败');
      }
    });
  },

  // 将外部词源（AI/手动）去重并入主列表，并重新筛选+分页
  mergeExternal(ext) {
    if (!ext || ext.length === 0) return;
    const added = [];
    for (let i = 0; i < ext.length; i++) {
      const it = ext[i];
      const exists = this.masterResults.some(m => m.word.toLowerCase() === it.word.toLowerCase());
      if (!exists) added.push(it);
    }
    if (added.length === 0) return;
    // 新词源置前（unshift）
    this.masterResults = added.concat(this.masterResults);
    this.applyFilters();
  },

  checkAIFavoriteStatus(aiItem) {
    try {
      const favSet = new Set(readFavorites().map(item => item.word));
      // 更新AI结果的收藏状态
      aiItem.isFavorited = favSet.has(aiItem.word);
    } catch (e) {
      console.error('检查AI结果收藏状态失败:', e);
    }
  },

  showDonationTip() {
    // 显示价格和捐赠提示
    console.log('显示捐赠提示');
  },

  checkFavoritesStatus() {
    try {
      const favorites = readFavorites();
      const favSet = new Set(favorites.map(item => item.word));
      // 更新每个结果的可收藏状态（O(n)，利用 Set 索引避免 O(n·m)）
      this.results.forEach(item => { item.isFavorited = favSet.has(item.word); });
    } catch (e) {
      console.error('检查收藏状态失败:', e);
    }
  },

  toggleFavorite(item, event) {
    // 阻止事件冒泡，防止触发跳转
    if (event && event.stopPropagation) {
      event.stopPropagation();
    }
    
    // 验证item参数
    if (!item || !item.word) {
      console.error('收藏失败：无效的item参数', item);
      return;
    }
    
    console.log('=== 收藏按钮被点击 ===');
    console.log('单词:', item.word);
    console.log('当前状态:', item.isFavorited);
    
    // 获取当前收藏列表（复用统一的安全读取逻辑）
    let favorites = readFavorites();
    console.log('获取收藏列表成功，数量:', favorites.length);
    
    // 查找当前单词在收藏列表中的索引
    const existingIndex = favorites.findIndex(fav => fav.word === item.word);
    console.log('单词在收藏列表中的位置:', existingIndex);
    
    if (existingIndex >= 0) {
      // 取消收藏
      favorites.splice(existingIndex, 1);
      item.isFavorited = false;
      console.log('取消收藏成功');
    } else {
      // 添加收藏
      favorites.push({
        word: item.word,
        definition: item.definition || '',
        addedTime: new Date().getTime()
      });
      item.isFavorited = true;
      console.log('添加收藏成功');
    }
    
    // 保存收藏列表（统一异常处理）
    if (!saveFavorites(favorites)) {
      console.error('保存收藏失败');
      item.isFavorited = existingIndex >= 0;  // 恢复原始状态
    } else {
      console.log('保存收藏列表成功');
    }
  },

  goBack() {
    router.back();
  },

  goToDetail(item) {
    console.log('=== 开始跳转到详情页 ===');
    console.log('单词:', item.word);
    console.log('释义:', item.definition);
    console.log('完整item对象:', JSON.stringify(item));
    
    // 确保参数存在
    if (!item || !item.word) {
      console.error('跳转失败：缺少必要参数');
      return;
    }
    
    // 确保全局变量对象存在
    if (!this.$app.globalData) {
      this.$app.globalData = {};
    }
    
    // 设置全局变量
    this.$app.globalData.word = item.word;
    this.$app.globalData.definition = item.definition || '';
    console.log('已设置全局变量:', this.$app.globalData);
    
    // 方法2：尝试标准跳转
    try {
      router.push({
        uri: '/pages/detail',
        params: {
          word: item.word,
          definition: item.definition || ''
        }
      });
      
      console.log('标准跳转调用成功');
    } catch (error) {
      console.error('标准跳转失败:', error);
      
      // 方法3：简化跳转
      try {
        router.push({
          uri: '/pages/detail'
        });
        console.log('简化跳转调用成功');
      } catch (simpleError) {
        console.error('简化跳转也失败:', simpleError);
      }
    }
    
    console.log('=== 跳转方法调用完成 ===');
  },

  closeDonationTip() {
    this.showDonation = false;
  },

  onDestroy() {
    // 页面销毁时清理数据，避免内存泄漏
    this.results.length = 0;
    this.word = "";
    // 释放二级桶缓存（LRU 桶对象），降低常驻内存
    clearCache();
    // 调用垃圾回收
    if (typeof global !== 'undefined' && global.runGC) {
      global.runGC();
    }
  }
}
</script>

