      self.showDonationAlert = true;
      console.log('AI查询成功，结果已添加并保存到词典');
    }).catch(function (error) {
      console.error('AI查询失败:', error);
      self.aiError = error && error.message || 'AI查询服务暂时不可用';
    }).then(function () {
      self.isLoadingAI = false;
    });
